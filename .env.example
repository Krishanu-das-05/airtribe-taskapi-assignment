# Copy to .env and fill in real values. .env is git-ignored - never commit it.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (used by both Django and docker-compose.yml)
POSTGRES_DB=taskapi
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Natural-language parser: "rules" (offline, default) or "llm"
TASK_PARSER=rules
# Only needed when TASK_PARSER=llm
LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
